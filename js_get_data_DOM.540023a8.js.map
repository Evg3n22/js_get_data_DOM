var allPopulation = document.querySelectorAll('.population');
var totalPopulation = 0;
allPopulation.forEach(function(element) {
    var population = +element.textContent.split(',').join('');
    totalPopulation += population;
});
var total = document.querySelector('.total-population');
var average = document.querySelector('.average-population');
var averagePopulation = Math.round(totalPopulation / allPopulation.length);
total.textContent = formatNumber(totalPopulation);
average.textContent = formatNumber(averagePopulation);
function formatNumber(number) {
    var str = '';
    str = number.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    return str;
}

